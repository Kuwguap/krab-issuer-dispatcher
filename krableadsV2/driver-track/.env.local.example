# Supabase project URL (server-side only)
SUPABASE_URL=

# Supabase service role key (server-side only — never expose to the client)
SUPABASE_KEY=

# Passcode required to access /admin
TRACK_ADMIN_PASSCODE=

# Random hex secret used to HMAC-sign the admin session cookie (e.g. `openssl rand -hex 32`)
ADMIN_COOKIE_SECRET=

# Telegram bot username WITHOUT the @ (used for the "Open Telegram" button on /t/<token>)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
