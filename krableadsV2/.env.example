# NJ Temporary Evidence of Insurance (upstream barcode-app HTTP endpoint)
BARCODE_APP_BASE_URL=

# External lead ingest API (POST /api/v1/leads/ingest on krab-issuer-admin)
# Share LEAD_INGEST_API_KEY with the other website only — not Telegram tokens.
LEAD_INGEST_API_KEY=
# Virtual issuer for API leads: Telegram @username (default tristatetag) or numeric user id
API_LEAD_USER_ID=tristatetag
LEAD_INGEST_SOURCE_LABEL=External API

# Client follow-up outreach (/followup — bot texts + emails the client to chase the VIN)
# SMS is optional; without Twilio the bot still emails the client via Resend.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FOLLOWUP_AGENCY_NAME=Tri State Coverage
