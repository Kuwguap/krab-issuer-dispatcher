# NJ Temporary Evidence of Insurance (upstream barcode-app HTTP endpoint)
BARCODE_APP_BASE_URL=

# External lead ingest API (POST /api/v1/leads/ingest on krab-issuer-admin)
# Share LEAD_INGEST_API_KEY with the other website only — not Telegram tokens.
LEAD_INGEST_API_KEY=
# Virtual issuer for API leads: Telegram @username (default tristatetag) or numeric user id
API_LEAD_USER_ID=tristatetag
LEAD_INGEST_SOURCE_LABEL=External API

# Driver GPS tracking (driver-track site on Vercel). When set, drivers must
# share their location on this site before the bot sends delivery details.
TRACKING_SITE_BASE_URL=
TRACKING_TIMEOUT_MINUTES=5
TRACKING_ARRIVAL_RADIUS_M=200

# Client follow-up outreach (/followup — bot texts + emails the client to chase the VIN)
# SMS is optional; without Twilio the bot still emails the client via Resend.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FOLLOWUP_AGENCY_NAME=Tri State Coverage
FOLLOWUP_WEBSITE=Www.tristatetags.com
FOLLOWUP_PHONE=551-301-3737
FOLLOWUP_EMAIL_COPY=SendReceiptToday@gmail.com
# Email fallback when Resend isn't set: reuse the krab-sender SendGrid key.
# SENDGRID_FROM must be a verified sender, e.g. "Tri State Tags <you@domain.com>"
SENDGRID_API_KEY=
SENDGRID_FROM=

# Immediate ledger registration on the krab-dispatch backend
KRAB_DISPATCH_API_URL=https://krab-dispatch-api.onrender.com
KRAB_DISPATCH_ADMIN_PASSWORD=

# ── Receipt portal + instant PDF (tristatetags.com/backend) ─────────────────
# Where drivers reach the upload page and where receipts are served FROM. The bot
# and the dashboard must agree on this value or the links they build will not match.
RECEIPT_PORTAL_BASE=https://tristatetags.com/backend
# Signs the /r/<token> upload links. Defaults to SUPABASE_KEY (already shared by
# both services) — set it explicitly if the bot and dashboard use different keys.
RECEIPT_LINK_SECRET=

# $100 instant PDF: pay, and the tag goes straight to the chosen driver.
# The SAME Stripe account as tristatecoverage.com — copy the key from there.
STRIPE_SECRET_KEY=
# From the Stripe dashboard's webhook endpoint for
#   https://tristatetags.com/backend/api/stripe/webhook
# Without it every webhook is refused and paid tags are never delivered.
STRIPE_WEBHOOK_SECRET=
# In cents. 10000 = $100.00
INSTANT_PDF_CENTS=10000

# Insurance portal (tristatecoverage.com). The same key must be set on BOTH the
# bot and the TriStateCoverage deployment, or account creation 401s.
TRISTATECOVERAGE_API_BASE=https://tristatecoverage.com
INTEGRATIONS_API_KEY=

# Who may open /settings, /drivers, /leaderboard and see every entry. Comma or
# space separated Telegram ids. More can be added from inside /settings; these
# ones are fixed and cannot be removed there.
SUPERVISORY_TELEGRAM_ID=
