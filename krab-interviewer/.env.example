# Web form + admin dashboard (FastAPI on PORT, same process as bot)
ADMIN_PASSWORD=
IP_HASH_SALT=change-me-in-production
KRAB_API_CORS_ALLOWED_ORIGINS=*
KRAB_PUBLIC_BASE_URL=https://krab-interviewer-bot.onrender.com
