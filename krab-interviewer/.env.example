DRIVER_CHANNEL_ID=-1003722851371
DRIVER_CHANNEL_LINK=https://t.me/TriStateTags
KRAB_SENDER_DATABASE_URL=
INTERVIEWER_TIMEZONE=America/New_York
KRAB_ISSUER_BOT_USERNAME=Krabissuerbot
KRAB_DISPATCH_BOT_USERNAME=Krabdispatchbot
KRAB_INTERVIEWER_BOT_USERNAME=krabinterviewerbot
PAPER_GIRL_TELEGRAM_ID=
# Comma-separated group/supergroup IDs that also receive paper-girl shipment alerts
PAPER_GIRL_NOTIFY_CHAT_IDS=-1003903904177
# Comma-separated @usernames shown in hire channel post (e.g. etalyanka,otheruser)
PAPER_GIRL_USERNAME=etalyanka
